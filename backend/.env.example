# ========================
# SCBARH — Environment Variables
# Copie este ficheiro para .env e preencha com os seus valores
# ========================

# Aplicação
APP_NAME="SCBARH"
APP_ENV="development"
APP_PORT=8000
DEBUG=true

# Base de Dados MySQL (XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scbarh_db
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET_KEY=MUDE_ESTA_CHAVE_SECRETA_EM_PRODUCAO_USE_OPENSSL_RAND
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — Frontend Next.js
ALLOWED_ORIGINS=http://localhost:4028,http://127.0.0.1:4028

# Email (SMTP)
MAIL_USERNAME=no-reply@scbarh.ao
MAIL_PASSWORD=sua_password_email
MAIL_FROM=no-reply@scbarh.ao
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
